{
  "name": "@crazyfactory/uptrans",
  "private": false,
  "description": "",
  "main": "./lib/index.js",
  "bin": {
    "uptrans": "./bin/cli.js"
  },
  "typings": "./lib/index",
  "module": "./lib.es2015/index.js",
  "jsnext:main": "./lib.es2015/index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/crazyfactory/translation_updater.git"
  },
  "homepage": "https://github.com/crazyfactory/translation_updater",
  "dependencies": {
    "@octokit/rest": "^20.0.0",
    "fallback-cli": "^2.0.2"
  },
  "devDependencies": {
    "@types/jest": "^23.3.7",
    "@types/node": "^18.0.0",
    "del-cli": "^1.0.0",
    "husky": "^1.1.2",
    "jest": "^23.6.0",
    "semantic-release": "^19.0.0",
    "ts-jest": "^23.10.4",
    "typescript": "^4.9.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "validate-commit-msg": "^2.14.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/commit-analyzer": "^9.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^8.0.0",
    "@semantic-release/npm": "^9.0.0",
    "@semantic-release/release-notes-generator": "^10.0.0"
  },
  "scripts": {
    "test": "jest",
    "test:no-cache": "jest --no-cache",
    "test:watch": "jest --watch",
    "build": "npm run clean && tsc -p .",
    "clean": "del-cli ./lib ./coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "npm run lint -s -- --fix",
    "semantic-release": "semantic-release"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "cacheDirectory": "<rootDir>/.jest/cache",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "coveragePathIgnorePatterns": [
      "index.ts"
    ],
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx)$",
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "moduleDirectories": [
      "node_modules",
      "./"
    ],
    "setupTestFrameworkScriptFile": "./JestBootstrap.ts"
  },
  "husky": {
    "hooks": {
      "commit-msg": "validate-commit-msg",
      "pre-commit": "npm run lint -s",
      "pre-push": "npm run build -s && npm run test -s"
    }
  },
  "version": "1.1.3"
}
